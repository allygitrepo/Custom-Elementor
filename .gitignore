# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build outputs
dist/
client/dist/
build/
.vite/

# SQLite Database & Storage Files
*.sqlite
*.sqlite3
*.db
*.sqlite-shm
*.sqlite-wal
**/*.sqlite
**/*.sqlite3
**/*.db
server/storage/database/*
!server/storage/database/.gitkeep
!server/storage/database/.htaccess

# User Uploaded Media (Images, Videos, Documents)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/.htaccess
server/storage/uploads/*
!server/storage/uploads/.gitkeep
!server/storage/uploads/.htaccess
uploads/*
!uploads/.gitkeep

# Video and Audio Media Formats
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.flv
*.wmv
*.m4v
*.mp3
*.wav
*.ogg
*.m4a

# Published Static Websites
server/published/*
!server/published/.gitkeep
published/*
!published/.gitkeep

# Logs & Temporary Files
*.log
logs/
server/logs/*
!server/logs/.gitkeep
server/storage/logs/*
!server/storage/logs/.gitkeep
*.tmp
*.temp
*.bak
*.swp

# Prompts, Notes & Feature Text Files
*.txt
*prompt*.md
*.prompt.md
*.prompt

# Environment and Secret configs
.env
.env.local
.env.*.local

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
