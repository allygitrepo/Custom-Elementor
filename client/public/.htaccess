DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization Header to PHP in FastCGI / Apache environments
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Prevent direct access to sensitive PHP backend files, databases and logs
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^controllers/ - [F,L]
    RewriteRule ^middleware/ - [F,L]
    RewriteRule ^models/ - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^renderer/ - [F,L]
    RewriteRule ^core/ - [F,L]
    RewriteRule \.(sqlite|log|env|bak)$ - [F,L]

    # 1. Serve static assets, media, and published files directly if they exist
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Serve physical directories directly (allows DirectoryIndex to serve index.html)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Route uploaded media (/uploads/* and published/*/uploads/*) directly to server/uploads/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^published/([^/]+)/uploads/(.*)$ server/uploads/$2 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^server/published/([^/]+)/uploads/(.*)$ server/uploads/$2 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^uploads/(.*)$ server/uploads/$1 [L]

    # 3. Route all API requests (/api/*) to backend index.php (supports both server/ subfolder and root deployments)
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
    RewriteRule ^api/(.*)$ server/index.php [QSA,L]
    RewriteRule ^api$ server/index.php [QSA,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ index.php [QSA,L]
    RewriteRule ^api$ index.php [QSA,L]

    # 4. Fallback for all other client-side SPA routes to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Allow up to 1GB uploads
LimitRequestBody 1073741824

<IfModule mod_php.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value memory_limit 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value memory_limit 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value memory_limit 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
</IfModule>

